    {
      "@id": "urn:hoh:gui:interaction-rule/content-vertical",
      "@type": "h:InteractionRule",
      "h:authority": "SECONDARY_AI",
      "h:status": "USER_REQUIREMENT_INTERPRETATION",
      "prov:wasDerivedFrom": {
        "@id": "urn:hoh:gui:source/user-hoh-interaction-224832972605dd38116048037824500a391fadf911bcd998ffe5aaa47010698e"
      },
      "h:description": "콘텐츠 내부와 중첩 콘텐츠는 세로 스크롤만 제공하며 가로 스크롤로 피드 제스처를 점유하지 않는다.",
      "h:interactionComponent": {
        "@id": "urn:hoh:gui:component/content-viewer"
      },
      "h:interactionIntent": [
        {
          "@id": "urn:hoh:gui:shell-intent/content.scrollVertical"
        }
      ],
      "h:scrollAxes": "Y_ONLY",
      "h:gestureOrigin": "CONTENT_INTERIOR",
      "h:gestureDirection": "UP_OR_DOWN"
    },
    {
      "@id": "urn:hoh:gui:interaction-rule/feed-horizontal",
      "@type": "h:InteractionRule",
      "h:authority": "SECONDARY_AI",
      "h:status": "USER_REQUIREMENT_INTERPRETATION",
      "prov:wasDerivedFrom": {
        "@id": "urn:hoh:gui:source/user-hoh-interaction-224832972605dd38116048037824500a391fadf911bcd998ffe5aaa47010698e"
      },
      "h:description": "가로 스와이프는 셸의 피드 탐색이며 내부 콘텐츠 페이지 넘김이 아니다.",
      "h:interactionComponent": {
        "@id": "urn:hoh:gui:component/feed"
      },
      "h:interactionIntent": [
        {
          "@id": "urn:hoh:gui:shell-intent/feed.previous"
        },
        {
          "@id": "urn:hoh:gui:shell-intent/feed.next"
        }
      ],
      "h:gestureOrigin": "UNCLAIMED_CONTENT_NAVIGATION_AREA",
      "h:gestureDirection": "LEFT_OR_RIGHT"
    },
    {
      "@id": "urn:hoh:gui:interaction-rule/bottom-edge-agent",
      "@type": "h:InteractionRule",
      "h:authority": "SECONDARY_AI",
      "h:status": "USER_REQUIREMENT_INTERPRETATION",
      "prov:wasDerivedFrom": {
        "@id": "urn:hoh:gui:source/user-hoh-interaction-224832972605dd38116048037824500a391fadf911bcd998ffe5aaa47010698e"
      },
      "h:description": "가시 화면 하단에서 위로 끌어 AI를 열고 현재 콘텐츠를 유지한다. 콘텐츠 스크롤 끝 도달은 조건이 아니다.",
      "h:interactionComponent": {
        "@id": "urn:hoh:gui:component/agent"
      },
      "h:interactionIntent": [
        {
          "@id": "urn:hoh:gui:shell-intent/agent.open"
        }
      ],
      "h:gestureOrigin": "VIEWPORT_BOTTOM_EDGE",
      "h:gestureDirection": "UP",
      "h:scrollBoundaryRequired": false
    },
    {
      "@id": "urn:hoh:gui:interaction-rule/top-edge-dashboard",
      "@type": "h:InteractionRule",
      "h:authority": "SECONDARY_AI",
      "h:status": "USER_REQUIREMENT_INTERPRETATION",
      "prov:wasDerivedFrom": {
        "@id": "urn:hoh:gui:source/user-hoh-interaction-224832972605dd38116048037824500a391fadf911bcd998ffe5aaa47010698e"
      },
      "h:description": "가시 화면 상단에서 아래로 끌어 앱 메인 대시보드를 연다. 콘텐츠 스크롤 시작 도달은 조건이 아니다.",
      "h:interactionComponent": {
        "@id": "urn:hoh:gui:component/dashboard"
      },
      "h:interactionIntent": [
        {
          "@id": "urn:hoh:gui:shell-intent/dashboard.open"
        }
      ],
      "h:gestureOrigin": "VIEWPORT_TOP_EDGE",
      "h:gestureDirection": "DOWN",
      "h:scrollBoundaryRequired": false
    },
    {
      "@id": "urn:hoh:gui:interaction-rule/dashboard-grid",
      "@type": "h:InteractionRule",
      "h:authority": "SECONDARY_AI",
      "h:status": "USER_REQUIREMENT_INTERPRETATION",
      "prov:wasDerivedFrom": {
        "@id": "urn:hoh:gui:source/user-hoh-interaction-224832972605dd38116048037824500a391fadf911bcd998ffe5aaa47010698e"
      },
      "h:description": "고정 앱과 즐겨찾기를 앱 아이콘 그리드로 표시하고 설정을 고정 앱에 포함한다.",
      "h:interactionComponent": {
        "@id": "urn:hoh:gui:component/dashboard"
      },
      "h:interactionIntent": [
        {
          "@id": "urn:hoh:gui:shell-intent/dashboard.open"
        }
      ],
      "h:gridGroup": [
        "FIXED_APPS",
        "FAVORITES"
      ],
      "h:settingsPlacement": "APP_IN_FIXED_APPS",
      "h:scrollAxes": "Y_ONLY"
    },
    {
      "@id": "urn:hoh:gui:interaction-rule/reaction-glass",
      "@type": "h:InteractionRule",
      "h:authority": "SECONDARY_AI",
      "h:status": "USER_REQUIREMENT_INTERPRETATION",
      "prov:wasDerivedFrom": {
        "@id": "urn:hoh:gui:source/user-hoh-interaction-224832972605dd38116048037824500a391fadf911bcd998ffe5aaa47010698e"
      },
      "h:description": "좋아요·싫어요·댓글·공유는 콘텐츠 위에 떠 있는 글래스 UI다.",
      "h:interactionComponent": {
        "@id": "urn:hoh:gui:component/content-viewer"
      },
      "h:interactionIntent": [
        {
          "@id": "urn:hoh:gui:shell-intent/reaction.like"
        },
        {
          "@id": "urn:hoh:gui:shell-intent/reaction.dislike"
        },
        {
          "@id": "urn:hoh:gui:shell-intent/comments.open"
        },
        {
          "@id": "urn:hoh:gui:shell-intent/share.open"
        }
      ],
      "h:visualTreatment": "GLASSMORPHISM_OVERLAY"
    },
    {
      "@id": "urn:hoh:gui:interaction-rule/desktop-shortcuts",
      "@type": "h:InteractionRule",
      "h:authority": "SECONDARY_AI",
      "h:status": "USER_REQUIREMENT_INTERPRETATION",
      "prov:wasDerivedFrom": {
        "@id": "urn:hoh:gui:source/user-hoh-interaction-224832972605dd38116048037824500a391fadf911bcd998ffe5aaa47010698e"
      },
      "h:description": "웹은 제스처 없이 단축키로 같은 탐색·AI·대시보드 동작에 접근한다. 구체적 키 조합은 사용자 원문에 없다.",
      "h:interactionComponent": {
        "@id": "urn:hoh:gui:component/content-viewer"
      },
      "h:interactionIntent": [
        {
          "@id": "urn:hoh:gui:shell-intent/feed.previous"
        },
        {
          "@id": "urn:hoh:gui:shell-intent/feed.next"
        },
        {
          "@id": "urn:hoh:gui:shell-intent/agent.open"
        },
        {
          "@id": "urn:hoh:gui:shell-intent/dashboard.open"
        }
      ],
      "h:inputRoute": "CONFIGURABLE_KEYBOARD_SHORTCUTS"
    },
    {
      "@id": "urn:hoh:gui:interaction-rule/desktop-glass-controls",
      "@type": "h:InteractionRule",
      "h:authority": "SECONDARY_AI",
      "h:status": "USER_REQUIREMENT_INTERPRETATION",
      "prov:wasDerivedFrom": {
        "@id": "urn:hoh:gui:source/user-hoh-interaction-224832972605dd38116048037824500a391fadf911bcd998ffe5aaa47010698e"
      },
      "h:description": "넓은 화면은 AI 호출과 대시보드 열기를 명시적 글래스 버튼으로 제공한다.",
      "h:interactionComponent": {
        "@id": "urn:hoh:gui:component/content-viewer"
      },
      "h:interactionIntent": [
        {
          "@id": "urn:hoh:gui:shell-intent/agent.open"
        },
        {
          "@id": "urn:hoh:gui:shell-intent/dashboard.open"
        }
      ],
      "h:inputRoute": "VISIBLE_BUTTONS",
      "h:visualTreatment": "GLASSMORPHISM_OVERLAY"
    },
