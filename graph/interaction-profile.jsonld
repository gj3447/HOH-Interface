      },
      "rdfs:range": {
        "@id": "urn:hoh:gui:SemanticContentProtocol"
      },
      "rdfs:comment": "Profile to the content action contract; exactly one; navigation does not grant mutation permission."
    },
    {
      "@id": "urn:hoh:gui:interactionRule",
      "@type": "rdf:Property",
      "rdfs:domain": {
        "@id": "urn:hoh:gui:InteractionProfile"
      },
      "rdfs:range": {
        "@id": "urn:hoh:gui:InteractionRule"
      },
      "rdfs:comment": "Profile to its eight interpreted requirements; one-to-many, exactly eight in draft 0.1."
    },
    {
      "@id": "urn:hoh:gui:interactionDocument",
      "@type": "rdf:Property",
      "rdfs:domain": {
        "@id": "urn:hoh:gui:InteractionProfile"
      },
      "rdfs:range": {
        "@id": "prov:Entity"
      },
      "rdfs:comment": "Profile to its source-pinned specification; exactly one."
    },
    {
      "@id": "urn:hoh:gui:interactionObservation",
      "@type": "rdf:Property",
      "rdfs:domain": {
        "@id": "urn:hoh:gui:InteractionProfile"
      },
      "rdfs:range": {
        "@id": "prov:Entity"
      },
      "rdfs:comment": "Profile to a separately attributed source audit; exactly one; not runtime conformance."
    },
    {
      "@id": "urn:hoh:gui:interactionComponent",
      "@type": "rdf:Property",
      "rdfs:domain": {
        "@id": "urn:hoh:gui:InteractionRule"
      },
      "rdfs:range": {
        "@id": "urn:hoh:gui:Component"
      },
      "rdfs:comment": "Rule to its primary existing UI responsibility; exactly one."
    },
    {
      "@id": "urn:hoh:gui:interactionIntent",
      "@type": "rdf:Property",
      "rdfs:domain": {
        "@id": "urn:hoh:gui:InteractionRule"
      },
      "rdfs:range": {
        "@id": "urn:hoh:gui:ShellIntent"
      },
      "rdfs:comment": "Rule to the semantic intents it permits or presents; one-to-many, 1..4 in this profile."
    },
    {
      "@id": "urn:hoh:gui:scrollAxes",
      "@type": "rdf:Property",
      "rdfs:domain": {
        "@id": "urn:hoh:gui:InteractionRule"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "rdfs:comment": "Rule to allowed content scrolling axes; optional single Y_ONLY, not program control degrees of freedom."
    },
    {
      "@id": "urn:hoh:gui:gestureOrigin",
      "@type": "rdf:Property",
      "rdfs:domain": {
        "@id": "urn:hoh:gui:InteractionRule"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "rdfs:comment": "Rule to the pointer start region; optional single value; viewport boundary is independent of document scroll position."
    },
    {
      "@id": "urn:hoh:gui:gestureDirection",
      "@type": "rdf:Property",
      "rdfs:domain": {
        "@id": "urn:hoh:gui:InteractionRule"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "rdfs:comment": "Rule to recognized movement direction; optional single value; does not change start region."
    },
    {
      "@id": "urn:hoh:gui:scrollBoundaryRequired",
      "@type": "rdf:Property",
      "rdfs:domain": {
        "@id": "urn:hoh:gui:InteractionRule"
      },
      "rdfs:range": {
        "@id": "xsd:boolean"
      },
      "rdfs:comment": "Edge rule to whether content scroll position gates invocation; exactly false for both viewport-edge rules."
    },
