        }
      ]
    },
    {
      "@id": "urn:hoh:gui:requirement/semantic-identity",
      "@type": "h:Requirement",
      "h:authority": "SECONDARY_AI",
      "skos:prefLabel": "stable semantic identity and meaning",
      "h:description": "콘텐츠마다 안정 식별자, 제목·설명, 프로토콜 버전과 descriptor revision을 제공한다.",
      "h:satisfiedBy": {
        "@id": "urn:hoh:gui:contract/content-descriptor"
      },
      "h:satisfactionMeaning": "descriptor identity, description and revision fields"
    },
    {
      "@id": "urn:hoh:gui:requirement/observable-state",
      "@type": "h:Requirement",
      "h:authority": "SECONDARY_AI",
      "skos:prefLabel": "observable state",
      "h:description": "read와 subscribe로 콘텐츠 상태 및 state revision을 명시적으로 관찰 가능하게 한다.",
      "h:satisfiedBy": {
        "@id": "urn:hoh:gui:contract/runtime-methods"
      },
      "h:satisfactionMeaning": "read and subscribe methods expose current state and changes"
    },
    {
      "@id": "urn:hoh:gui:requirement/discoverable-typed-actions",
      "@type": "h:Requirement",
      "h:authority": "SECONDARY_AI",
      "skos:prefLabel": "discoverable typed actions",
      "h:description": "조작 이름, 입력·출력 스키마, effect(read/write/external), 확인과 사용자 제스처 요구를 선언하여 발견 가능하게 한다.",
      "h:satisfiedBy": {
        "@id": "urn:hoh:gui:contract/content-descriptor"
      },
      "h:satisfactionMeaning": "descriptor actions declare typed inputs, outputs and effect constraints"
    },
    {
      "@id": "urn:hoh:gui:requirement/shared-human-ai-dispatch",
      "@type": "h:Requirement",
      "h:authority": "SECONDARY_AI",
      "skos:prefLabel": "shared human and AI dispatch",
      "h:description": "사람 UI와 AI 에이전트는 동일한 invoke 디스패처·검증·권한 정책을 지나며 actor는 JSON 입력이 아니라 신뢰된 호스트 문맥에서만 공급한다.",
      "h:satisfiedBy": [
        {
          "@id": "urn:hoh:gui:contract/invoke-request"
        },
        {
          "@id": "urn:hoh:gui:contract/runtime-methods"
        }
      ],
      "h:satisfactionMeaning": "shared request envelope plus host-bound runtime dispatch"
    },
    {
      "@id": "urn:hoh:gui:requirement/outcome-provenance",
      "@type": "h:Requirement",
      "h:authority": "SECONDARY_AI",
      "skos:prefLabel": "outcome and provenance",
      "h:description": "각 실행은 idempotency key, 결과, 상태 revision, 발생 이벤트 및 호스트 출처를 남긴다.",
      "h:satisfiedBy": {
        "@id": "urn:hoh:gui:contract/action-outcome"
      },
      "h:satisfactionMeaning": "outcome returns snapshot, output and receipt"
    },
    {
      "@id": "urn:hoh:gui:requirement/human-control",
      "@type": "h:Requirement",
      "h:authority": "SECONDARY_AI",
      "skos:prefLabel": "human control",
      "h:description": "사람은 같은 콘텐츠를 직접 보고, 허용된 조작을 수행하고, 확인이 필요한 실행을 승인한다.",
      "h:satisfiedBy": {
        "@id": "urn:hoh:gui:contract/runtime-methods"
      },
      "h:satisfactionMeaning": "host uses the same methods and confirmation policy for direct interaction"
    },
    {
      "@id": "urn:hoh:gui:contract/content-descriptor",
      "@type": "h:SemanticContentContract",
      "h:authority": "SECONDARY_AI",
      "h:fields": [
        "@context",
        "@type",
        "id",
        "title",
        "description",
        "protocolVersion",
        "descriptorRevision",
        "stateSchema",
        "actions",
        "profiles",
        "events",
        "links"
      ],
      "h:description": "descriptor.schema.json의 콘텐츠 의미·상태 스키마·발견 가능한 조작 계약."
    },
    {
      "@id": "urn:hoh:gui:contract/invoke-request",
      "@type": "h:SemanticContentContract",
      "h:authority": "SECONDARY_AI",
      "h:fields": [
        "contentId",
        "descriptorRevision",
        "actionId",
        "input",
        "expectedStateRevision",
        "idempotencyKey"
      ],
      "h:description": "invoke.schema.json의 공통 JSON 명령 계약. actor는 이 JSON에 포함되지 않고 호스트 신뢰 문맥에서만 공급된다."
    },
    {
      "@id": "urn:hoh:gui:contract/runtime-methods",
      "@type": "h:SemanticContentContract",
      "h:authority": "SECONDARY_AI",
      "h:fields": [
        "describe",
        "read",
        "invoke",
        "subscribe"
      ],
      "h:description": "runtime.js가 제공하는 네 가지 메서드와 host-bound actor 문맥의 계약."
    },
    {
      "@id": "urn:hoh:gui:contract/action-outcome",
      "@type": "h:SemanticContentContract",
      "h:authority": "SECONDARY_AI",
      "h:fields": [
        "ok",
        "snapshot",
        "output",
        "receipt"
      ],
      "h:description": "invoke가 반환하는 상태 snapshot, action output 및 provenance·idempotency 정보를 담은 receipt 계약."
    },
    {
      "@id": "urn:hoh:gui:model/shared-dispatch",
      "@type": "h:InteractionModel",
      "h:authority": "SECONDARY_AI",
      "h:hasParticipant": [
        {
          "@id": "urn:hoh:gui:participant/human"
        },
        {
          "@id": "urn:hoh:gui:participant/ai-agent"
        }
      ],
      "h:usesDispatcher": {
        "@id": "urn:hoh:gui:dispatcher/content-action"
      },
      "h:description": "UI 이벤트와 에이전트 툴 호출이 동일한 조작 정의와 결과를 공유한다."
    },
    {
      "@id": "urn:hoh:gui:participant/human",
      "@type": "h:HumanParticipant",
      "h:authority": "SECONDARY_AI"
    },
    {
      "@id": "urn:hoh:gui:participant/ai-agent",
      "@type": "h:AgentParticipant",
      "h:authority": "SECONDARY_AI"
    },
    {
      "@id": "urn:hoh:gui:dispatcher/content-action",
      "@type": "h:ActionDispatcher",
      "h:authority": "SECONDARY_AI",
      "h:validatesAgainst": {
        "@id": "urn:hoh:gui:contract/invoke-request"
      },
      "h:producesOutcome": {
        "@id": "urn:hoh:gui:contract/action-outcome"
      },
      "h:emitsEvent": {
        "@id": "urn:hoh:gui:event/content-changed"
      },
      "h:description": "신뢰된 host actor 문맥으로 권한·확인·입력·descriptor revision·expected state revision·idempotency key를 검사한 후 콘텐츠 어댑터를 호출한다."
    },
    {
      "@id": "urn:hoh:gui:event/content-changed",
      "@type": "h:ContentEvent",
      "h:authority": "SECONDARY_AI",
      "skos:prefLabel": "content.changed"
    },
    {
      "@id": "urn:hoh:gui:profile/hswm-optional",
      "@type": "h:SemanticProfile",
      "h:authority": "SECONDARY_AI",
      "h:status": "OPTIONAL_PROJECTION_NOT_CONNECTED",
      "h:description": "HSWM/표준 그래프 온톨로지로 콘텐츠 의미와 결과 출처를 투영할 수 있는 선택 프로파일. HSWM 실행이나 원격 연결을 뜻하지 않는다."
    },
    {
      "@id": "urn:hoh:gui:bridge/mcp-in-process",
      "@type": "h:BridgeMapping",
      "h:authority": "SECONDARY_AI",
      "h:status": "IMPLEMENTED_IN_PROCESS_MAPPING_NOT_MCP_SERVER",
      "h:mapsConcept": "declared non-gesture, non-external typed action to in-process tool; descriptor and state to in-process resource",
      "h:description": "protocol/mcp-mapping.js의 순수 in-process 자원·도구 페이로드 매핑이다. MCP transport, 인증 서버, Apps runtime 또는 규격 호환성을 주장하지 않는다."
    },
