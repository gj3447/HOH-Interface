      "h:recordedAt": "2026-10-07"
    },
    {
      "@id": "urn:hoh:gui:semantic-content-protocol/v0.1-draft",
      "@type": "h:SemanticContentProtocol",
      "skos:prefLabel": "HOH Semantic Content Protocol 0.1 draft",
      "h:authority": "SECONDARY_AI",
      "h:origin": "USER_EXPLICIT_REQUIREMENT_INTERPRETATION",
      "h:status": "DRAFT_NOT_STANDARD",
      "h:description": "콘텐츠 기술자와 동일 디스패처를 통해 의미·상태·조작을 기계가 읽게 하는 HOH 인터페이스 초안. 사람과 AI는 같은 권한·검증·결과 경로를 사용하며 actor는 호스트 문맥에서만 주입된다.",
      "h:extends": {
        "@id": "urn:hoh:gui:hoh-ui"
      },
      "prov:wasDerivedFrom": {
        "@id": "urn:hoh:gui:source/user-hoh-semantic-content-918a2adc46488a8cf1d17209b62b659f3f30abd93ba2f4b30150d6ca64a64afc"
      },
      "h:hasRequirement": [
        {
          "@id": "urn:hoh:gui:requirement/semantic-identity"
        },
        {
          "@id": "urn:hoh:gui:requirement/observable-state"
        },
        {
          "@id": "urn:hoh:gui:requirement/discoverable-typed-actions"
        },
        {
          "@id": "urn:hoh:gui:requirement/shared-human-ai-dispatch"
        },
        {
          "@id": "urn:hoh:gui:requirement/outcome-provenance"
        },
        {
          "@id": "urn:hoh:gui:requirement/human-control"
        }
      ],
      "h:definesContract": [
        {
          "@id": "urn:hoh:gui:contract/content-descriptor"
        },
        {
          "@id": "urn:hoh:gui:contract/invoke-request"
        },
        {
          "@id": "urn:hoh:gui:contract/runtime-methods"
        },
        {
          "@id": "urn:hoh:gui:contract/action-outcome"
        }
      ],
