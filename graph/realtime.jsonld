    {
      "@id": "urn:hoh:gui:capability/audio-call",
      "@type": "h:RealtimeCapability",
      "skos:prefLabel": "음성 통화",
      "h:authority": "SECONDARY_AI",
      "h:requiresGuiState": [
        "waiting",
        "connected",
        "error",
        "closed"
      ]
    },
    {
      "@id": "urn:hoh:gui:capability/video-call",
      "@type": "h:RealtimeCapability",
      "skos:prefLabel": "영상 통화",
      "h:authority": "SECONDARY_AI",
      "h:requiresGuiState": [
        "permission",
        "waiting",
        "connected",
        "error",
        "closed"
      ]
    },
    {
      "@id": "urn:hoh:gui:capability/broadcast",
      "@type": "h:RealtimeCapability",
      "skos:prefLabel": "방송 발행 및 시청",
      "h:authority": "SECONDARY_AI",
      "h:requiresGuiState": [
        "permission",
        "waiting",
        "connected",
        "error",
        "closed"
      ]
    },
    {
      "@id": "urn:hoh:gui:contract/realtime-session",
      "@type": "h:SessionContract",
      "h:authority": "SECONDARY_AI",
      "h:description": "호스트 authorize와 provider를 통해 권한 있는 방에만 연결하며, 콘텐츠 payload는 모드·역할 힌트만 제공한다.",
      "h:operations": [
        "getSnapshot",
        "subscribe",
        "isActive",
        "join",
        "leave",
        "close",
        "setMicrophone",
        "setCamera",
        "shareScreen",
        "stopScreenShare"
      ],
      "h:snapshotFields": [
        "status",
        "localStream",
        "peers",
        "microphoneEnabled",
        "cameraEnabled",
        "screenSharing",
        "error",
        "capabilities"
      ],
      "h:authorizationBoundary": "HOST_AUTHORIZE_REQUIRED",
      "h:contentRoomBinding": "HOST_ASSIGNED_ONLY",
      "h:technicalReference": [
        {
          "@id": "urn:hoh:gui:external/webrtc-spec"
        },
        {
          "@id": "urn:hoh:gui:external/mediacapture-streams-spec"
        },
        {
          "@id": "urn:hoh:gui:external/screen-capture-spec"
        }
      ],
      "rdfs:subClassOf": {
        "@id": "h:InterfaceContract"
      }
    },
    {
      "@id": "urn:hoh:gui:gui-contract/realtime-content",
      "@type": "h:GuiContract",
      "h:authority": "SECONDARY_AI",
      "h:description": "콘텐츠와 AI 두 영역을 유지한다. 좌측 즐겨찾기·우측 반응 버튼에는 유리 패널과 명확한 아이콘·44px 조작 영역을 제공하고, 모바일 채팅 높이는 하나의 상태 규칙을 사용한다. 통화·방송 상태와 참여·종료·마이크·카메라·공유 제어를 콘텐츠 안에서 제공한다.",
      "h:retainsShell": [
        {
          "@id": "urn:hoh:gui:component/content-viewer"
        },
        {
          "@id": "urn:hoh:gui:component/agent"
        }
      ],
      "h:requiresUserGestureFor": [
        "camera",
        "microphone",
        "screen-share"
      ],
      "h:activeNavigation": "CONFIRM_LEAVE",
      "h:rerenderPolicy": "RETAIN_SAME_CONTENT_SESSION",
      "h:disposePolicy": "END_MEDIA_ON_PAGEHIDE_OR_SHELL_DESTROY",
      "rdfs:subClassOf": {
        "@id": "h:InterfaceContract"
      }
    },
