    {
      "@id": "urn:hoh:gui:realtime-extension",
      "@type": "h:RealtimeExtension",
      "skos:prefLabel": "HOH 실시간 콘텐츠 확장",
      "h:authority": "SECONDARY_AI",
      "h:origin": "USER_EXPLICIT_REQUIREMENT_INTERPRETATION",
      "h:description": "통화·영상 통화·방송을 HOH 콘텐츠 뷰어에서 실행되는 프로그램으로 다루는 확장 계약. 실서비스 배포나 규격 적합성 인증을 뜻하지 않는다.",
      "h:extends": {
        "@id": "urn:hoh:gui:hoh-ui"
      },
      "prov:wasDerivedFrom": {
        "@id": "urn:hoh:gui:source/user-hoh-realtime-2fc7f11a964c51ab8de7bf41ccdf23b42b099154c6d72d9b2233509278f4ad6a"
      },
