          "@id": "urn:hoh:gui:capability/audio-call"
        },
        {
          "@id": "urn:hoh:gui:capability/video-call"
        },
        {
          "@id": "urn:hoh:gui:capability/broadcast"
        }
      ],
      "h:requiresContract": {
        "@id": "urn:hoh:gui:contract/realtime-session"
      },
      "h:hasLifecycle": {
        "@id": "urn:hoh:gui:lifecycle/realtime-session"
      },
