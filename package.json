{
  "name": "@hoh/ui",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "HOH Interface: a minimal AI-native interaction layer for executable content and agent-directed work.",
  "license": "AGPL-3.0-only",
  "author": "MetaHumotonic Foundation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gj3447/HOH-Interface.git"
  },
  "homepage": "https://github.com/gj3447/HOH-Interface#readme",
  "bugs": {
    "url": "https://github.com/gj3447/HOH-Interface/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": "./ui/hoh-ui.js",
    "./styles.css": "./ui/hoh-ui.css",
    "./adapters/program-feed": "./adapters/program-feed.js",
    "./realtime/session": "./ui/realtime-session.js",
    "./realtime/contracts": "./realtime/contracts.d.ts",
    "./adapters/local-webrtc": "./adapters/local-webrtc.js",
    "./content/runtime": {
      "types": "./protocol/contracts.d.ts",
      "import": "./protocol/runtime.js"
    },
    "./content/contracts": "./protocol/contracts.d.ts",
    "./content/agent-session": "./protocol/agent-session.js",
    "./content/mcp-mapping": "./protocol/mcp-mapping.js"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "preview": "node scripts/preview.mjs",
    "export:metahumotonic": "node scripts/export-metahumotonic.mjs",
    "test:browser": "node test/browser-context.mjs",
    "test:realtime": "node test/browser-realtime.mjs",
    "test:host": "node test/browser-host.mjs",
    "build:semantic": "node scripts/build-semantic-validators.mjs",
    "check:semantic": "node scripts/build-semantic-validators.mjs --check",
    "test:semantic:browser": "node test/browser-semantic.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
